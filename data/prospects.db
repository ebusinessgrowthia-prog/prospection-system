             'en', 'audit', 1)
        ]
        
        for name, subject, content, language, category, is_active in default_templates:
            self.cursor.execute('''
            INSERT OR IGNORE INTO email_templates (name, subject_template, content_template, language, category, is_active)
            VALUES (?, ?, ?, ?, ?, ?)
            ''', (name, subject, content, language, category, is_active))
        
        logger.info("Données par défaut insérées avec succès")
    
    def get_connection(self):
        """Retourne une connexion à la base de données"""
        if not self.connection:
            self.connection = sqlite3.connect(self.db_path)
            self.cursor = self.connection.cursor()
            self.cursor.execute("PRAGMA foreign_keys = ON")
        return self.connection
    
    def close_connection(self):
        """Ferme la connexion à la base de données"""
        if self.connection:
            self.connection.close()
            self.connection = None
            self.cursor = None
    
    def execute_query(self, query: str, params: tuple = None):
        """
        Exécute une requête SQL
        
        Args:
            query: Requête SQL à exécuter
            params: Paramètres de la requête
            
        Returns:
            Résultats de la requête
        """
        conn = self.get_connection()
        try:
            if params:
                self.cursor.execute(query, params)
            else:
                self.cursor.execute(query)
            
            if query.strip().upper().startswith(('SELECT', 'PRAGMA')):
                return self.cursor.fetchall()
            else:
                conn.commit()
                return self.cursor.rowcount
        except Exception as e:
            conn.rollback()
            logger.error(f"Erreur lors de l'exécution de la requête: {e}")
            raise
    
    def add_prospect(self, prospect_data: Dict[str, Any]) -> Optional[int]:
        """
        Ajoute un nouveau prospect à la base de données
        
        Args:
            prospect_data: Données du prospect
            
        Returns:
            ID du prospect ajouté ou None si échec
        """
        query = '''
        INSERT INTO prospects (name, company, email, sector, country, website, status, qualification_score, problem_detected, specificity, source)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        '''
        
        params = (
            prospect_data.get('name'),
            prospect_data.get('company'),
            prospect_data.get('email'),
            prospect_data.get('sector'),
            prospect_data.get('country'),
            prospect_data.get('website'),
            prospect_data.get('status', 'nouveau'),
            prospect_data.get('qualification_score', 0.0),
            prospect_data.get('problem_detected'),
            prospect_data.get('specificity'),
            prospect_data.get('source', 'google_dorks')
        )
        
        try:
            self.execute_query(query, params)
            return self.cursor.lastrowid
        except Exception as e:
            logger.error(f"Erreur lors de l'ajout du prospect: {e}")
            return None
    
    def get_prospect(self, prospect_id: int) -> Optional[Dict[str, Any]]:
        """
        Récupère un prospect par son ID
        
        Args:
            prospect_id: ID du prospect
            
        Returns:
            Données du prospect ou None si non trouvé
        """
        query = 'SELECT * FROM prospects WHERE id = ?'
        params = (prospect_id,)
        
        try:
            result = self.execute_query(query, params)
            if result:
                columns = [desc[0] for desc in self.cursor.description]
                return dict(zip(columns, result[0]))
            return None
        except Exception as e:
            logger.error(f"Erreur lors de la récupération du prospect: {e}")
            return None
    
    def update_prospect(self, prospect_id: int, update_data: Dict[str, Any]) -> bool:
        """
        Met à jour un prospect
        
        Args:
            prospect_id: ID du prospect
            update_data: Données à mettre à jour
            
        Returns:
            True si la mise à jour a réussi, False sinon
        """
        # Construire la requête de mise à jour dynamiquement
        set_clause = []
        params = []
        
        for key, value in update_data.items():
            set_clause.append(f"{key} = ?")
            params.append(value)
        
        if not set_clause:
            return False
        
        set_clause = ", ".join(set_clause)
        query = f'UPDATE prospects SET {set_clause} WHERE id = ?'
        params.append(prospect_id)
        
        try:
            rows_affected = self.execute_query(query, tuple(params))
            return rows_affected > 0
        except Exception as e:
            logger.error(f"Erreur lors de la mise à jour du prospect: {e}")
            return False
    
    def get_prospects(self, status: str = None, limit: int = None) -> List[Dict[str, Any]]:
        """
        Récupère la liste des prospects
        
        Args:
            status: Filtrer par statut
            limit: Limiter le nombre de résultats
            
        Returns:
            Liste des prospects
        """
        query = 'SELECT * FROM prospects'
        params = []
        
        if status:
            query += ' WHERE status = ?'
            params.append(status)
        
        query += ' ORDER BY date_added DESC'
        
        if limit:
            query += ' LIMIT ?'
            params.append(limit)
        
        try:
            results = self.execute_query(query, tuple(params) if params else None)
            if results:
                columns = [desc[0] for desc in self.cursor.description]
                return [dict(zip(columns, row)) for row in results]
            return []
        except Exception as e:
            logger.error(f"Erreur lors de la récupération des prospects: {e}")
            return []
    
    def add_email_campaign(self, campaign_data: Dict[str, Any]) -> Optional[int]:
        """
        Ajoute une campagne email à la base de données
        
        Args:
            campaign_data: Données de la campagne
            
        Returns:
            ID de la campagne ajoutée ou None si échec
        """
        query = '''
        INSERT INTO email_campaigns (prospect_id, subject, content, tracking_id)
        VALUES (?, ?, ?, ?)
        '''
        
        params = (
            campaign_data.get('prospect_id'),
            campaign_data.get('subject'),
            campaign_data.get('content'),
            campaign_data.get('tracking_id')
        )
        
        try:
            self.execute_query(query, params)
            return self.cursor.lastrowid
        except Exception as e:
            logger.error(f"Erreur lors de l'ajout de la campagne: {e}")
            return None
    
    def get_email_campaign(self, campaign_id: int) -> Optional[Dict[str, Any]]:
        """
        Récupère une campagne email par son ID
        
        Args:
            campaign_id: ID de la campagne
            
        Returns:
            Données de la campagne ou None si non trouvée
        """
        query = 'SELECT * FROM email_campaigns WHERE id = ?'
        params = (campaign_id,)
        
        try:
            result = self.execute_query(query, params)
            if result:
                columns = [desc[0] for desc in self.cursor.description]
                return dict(zip(columns, result[0]))
            return None
        except Exception as e:
            logger.error(f"Erreur lors de la récupération de la campagne: {e}")
            return None
    
    def update_email_campaign(self, campaign_id: int, update_data: Dict[str, Any]) -> bool:
        """
        Met à jour une campagne email
        
        Args:
            campaign_id: ID de la campagne
            update_data: Données à mettre à jour
            
        Returns:
            True si la mise à jour a réussi, False sinon
        """
        # Construire la requête de mise à jour dynamiquement
        set_clause = []
        params = []
        
        for key, value in update_data.items():
            set_clause.append(f"{key} = ?")
            params.append(value)
        
        if not set_clause:
            return False
        
        set_clause = ", ".join(set_clause)
        query = f'UPDATE email_campaigns SET {set_clause} WHERE id = ?'
        params.append(campaign_id)
        
        try:
            rows_affected = self.execute_query(query, tuple(params))
            return rows_affected > 0
        except Exception as e:
            logger.error(f"Erreur lors de la mise à jour de la campagne: {e}")
            return False
    
    def get_system_stats(self) -> Dict[str, Any]:
        """
        Récupère les statistiques système
        
        Returns:
            Statistiques système
        """
        try:
            # Statistiques des prospects
            prospect_stats = self.execute_query("SELECT status, COUNT(*) FROM prospects GROUP BY status")
            
            # Statistiques des campagnes
            campaign_stats = self.execute_query("SELECT delivery_status, COUNT(*) FROM email_campaigns GROUP BY delivery_status")
            
            # Statistiques par pays
            country_stats = self.execute_query("SELECT country, COUNT(*) FROM prospects WHERE country IS NOT NULL GROUP BY country")
            
            # Statistiques par secteur
            sector_stats = self.execute_query("SELECT sector, COUNT(*) FROM prospects WHERE sector IS NOT NULL GROUP BY sector")
            
            return {
                'prospects': {row[0]: row[1] for row in prospect_stats},
                'campaigns': {row[0]: row[1] for row in campaign_stats},
                'by_country': {row[0]: row[1] for row in country_stats},
                'by_sector': {row[0]: row[1] for row in sector_stats}
            }
        except Exception as e:
            logger.error(f"Erreur lors de la récupération des statistiques: {e}")
            return {}
    
    def log_system_event(self, level: str, message: str, module: str = None, extra_data: Dict[str, Any] = None):
        """
        Ajoute un événement système au log
        
        Args:
            level: Niveau de log
            message: Message du log
            module: Module concerné
            extra_data: Données supplémentaires
        """
        query = '''
        INSERT INTO system_logs (level, message, module, extra_data)
        VALUES (?, ?, ?, ?)
        '''
        
        params = (
            level,
            message,
            module,
            json.dumps(extra_data) if extra_data else None
        )
        
        try:
            self.execute_query(query, params)
        except Exception as e:
            logger.error(f"Erreur lors de l'ajout du log système: {e}")
    
    def cleanup_old_logs(self, days_to_keep: int = 30) -> int:
        """
        Nettoie les anciens logs système
        
        Args:
            days_to_keep: Nombre de jours à conserver
            
        Returns:
            Nombre de logs supprimés
        """
        query = "DELETE FROM system_logs WHERE created_at < datetime('now', '-' || ? || ' days')"
        params = (days_to_keep,)
        
        try:
            rows_affected = self.execute_query(query, params)
            logger.info(f"{rows_affected} logs système supprimés")
            return rows_affected
        except Exception as e:
            logger.error(f"Erreur lors du nettoyage des logs: {e}")
            return 0
    
    def backup_database(self, backup_path: str) -> bool:
        """
        Sauvegarde la base de données
        
        Args:
            backup_path: Chemin de la sauvegarde
            
        Returns:
            True si la sauvegarde a réussi, False sinon
        """
        try:
            import shutil
            shutil.copy2(self.db_path, backup_path)
            logger.info(f"Base de données sauvegardée vers {backup_path}")
            return True
        except Exception as e:
            logger.error(f"Erreur lors de la sauvegarde de la base de données: {e}")
            return False
    
    def restore_database(self, backup_path: str) -> bool:
        """
        Restaure la base de données depuis une sauvegarde
        
        Args:
            backup_path: Chemin de la sauvegarde
            
        Returns:
            True si la restauration a réussi, False sinon
        """
        try:
            import shutil
            shutil.copy2(backup_path, self.db_path)
            logger.info(f"Base de données restaurée depuis {backup_path}")
            return True
        except Exception as e:
            logger.error(f"Erreur lors de la restauration de la base de données: {e}")
            return False
    
    def get_database_info(self) -> Dict[str, Any]:
        """
        Récupère des informations sur la base de données
        
        Returns:
            Informations sur la base de données
        """
        try:
            import os
            
            # Taille de la base de données
            size = os.path.getsize(self.db_path)
            
            # Nombre de tables
            tables = self.execute_query("SELECT COUNT(*) FROM sqlite_master WHERE type='table'")
            table_count = tables[0][0] if tables else 0
            
            # Nombre de vues
            views = self.execute_query("SELECT COUNT(*) FROM sqlite_master WHERE type='view'")
            view_count = views[0][0] if views else 0
            
            # Nombre d'indexes
            indexes = self.execute_query("SELECT COUNT(*) FROM sqlite_master WHERE type='index'")
            index_count = indexes[0][0] if indexes else 0
            
            # Nombre de triggers
            triggers = self.execute_query("SELECT COUNT(*) FROM sqlite_master WHERE type='trigger'")
            trigger_count = triggers[0][0] if triggers else 0
            
            # Nombre de prospects
            prospects = self.execute_query("SELECT COUNT(*) FROM prospects")
            prospect_count = prospects[0][0] if prospects else 0
            
            # Nombre de campagnes
            campaigns = self.execute_query("SELECT COUNT(*) FROM email_campaigns")
            campaign_count = campaigns[0][0] if campaigns else 0
            
            return {
                'file_path': self.db_path,
                'size_bytes': size,
                'size_mb': round(size / (1024 * 1024), 2),
                'table_count': table_count,
                'view_count': view_count,
                'index_count': index_count,
                'trigger_count': trigger_count,
                'prospect_count': prospect_count,
                'campaign_count': campaign_count
            }
        except Exception as e:
            logger.error(f"Erreur lors de la récupération des informations de la base de données: {e}")
            return {}

# Instance globale de la base de données
db = EBUSINESSDatabase()

# Fonctions utilitaires pour la compatibilité
def get_database_connection():
    """Retourne une connexion à la base de données"""
    return db.get_connection()

def add_prospect(prospect_data: Dict[str, Any]) -> Optional[int]:
    """Ajoute un prospect à la base de données"""
    return db.add_prospect(prospect_data)

def get_prospect(prospect_id: int) -> Optional[Dict[str, Any]]:
    """Récupère un prospect par son ID"""
    return db.get_prospect(prospect_id)

def update_prospect(prospect_id: int, update_data: Dict[str, Any]) -> bool:
    """Met à jour un prospect"""
    return db.update_prospect(prospect_id, update_data)

def get_prospects(status: str = None, limit: int = None) -> List[Dict[str, Any]]:
    """Récupère la liste des prospects"""
    return db.get_prospects(status, limit)

def add_email_campaign(campaign_data: Dict[str, Any]) -> Optional[int]:
    """Ajoute une campagne email"""
    return db.add_email_campaign(campaign_data)

def get_email_campaign(campaign_id: int) -> Optional[Dict[str, Any]]:
    """Récupère une campagne email par son ID"""
    return db.get_email_campaign(campaign_id)

def update_email_campaign(campaign_id: int, update_data: Dict[str, Any]) -> bool:
    """Met à jour une campagne email"""
    return db.update_email_campaign(campaign_id, update_data)

def get_system_stats() -> Dict[str, Any]:
    """Récupère les statistiques système"""
    return db.get_system_stats()

def log_system_event(level: str, message: str, module: str = None, extra_data: Dict[str, Any] = None):
    """Ajoute un événement système au log"""
    db.log_system_event(level, message, module, extra_data)

def cleanup_old_logs(days_to_keep: int = 30) -> int:
    """Nettoie les anciens logs système"""
    return db.cleanup_old_logs(days_to_keep)

def get_database_info() -> Dict[str, Any]:
    """Récupère des informations sur la base de données"""
    return db.get_database_info()
