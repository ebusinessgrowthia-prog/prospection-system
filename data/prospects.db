"""
Fichier de base de données SQLite pour EBUSINESS AI
Ce fichier sera généré automatiquement par le système et contiendra toutes les données nécessaires
"""

import sqlite3
import os
import json
from datetime import datetime
from typing import List, Dict, Any, Optional
import logging

# Configuration du logging
logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
logger = logging.getLogger(__name__)

class EBUSINESSDatabase:
    """Classe de gestion de la base de données EBUSINESS AI"""
    
    def __init__(self, db_path: str = "data/prospects.db"):
        """
        Initialise la base de données
        
        Args:
            db_path: Chemin vers le fichier de base de données
        """
        self.db_path = db_path
        self.connection = None
        self.cursor = None
        
        # Créer le répertoire data s'il n'existe pas
        os.makedirs(os.path.dirname(db_path), exist_ok=True)
        
        # Initialiser la base de données
        self._initialize_database()
    
    def _initialize_database(self):
        """Initialise la base de données avec toutes les tables nécessaires"""
        try:
            # Se connecter à la base de données
            self.connection = sqlite3.connect(self.db_path)
            self.cursor = self.connection.cursor()
            
            # Activer les contraintes de clé étrangère
            self.cursor.execute("PRAGMA foreign_keys = ON")
            
            # Créer les tables
            self._create_tables()
            
            # Créer les indexes
            self._create_indexes()
            
            # Créer les triggers
            self._create_triggers()
            
            # Créer les vues
            self._create_views()
            
            # Insérer les données par défaut
            self._insert_default_data()
            
            logger.info("Base de données initialisée avec succès")
            
        except Exception as e:
            logger.error(f"Erreur lors de l'initialisation de la base de données: {e}")
            raise
    
    def _create_tables(self):
        """Crée toutes les tables nécessaires"""
        
        # Table des prospects
        self.cursor.execute('''
        CREATE TABLE IF NOT EXISTS prospects (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            company TEXT NOT NULL,
            email TEXT,
            sector TEXT,
            country TEXT,
            website TEXT,
            phone TEXT,
            status TEXT DEFAULT 'nouveau' CHECK(status IN ('nouveau', 'qualifié', 'contacté', 'répondu', 'audit_réservé', 'inactif')),
            qualification_score REAL DEFAULT 0.0 CHECK(qualification_score >= 0 AND qualification_score <= 10),
            problem_detected TEXT,
            specificity TEXT,
            date_added TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            date_contacted TIMESTAMP,
            date_responded TIMESTAMP,
            date_audit_booked TIMESTAMP,
            email_sent BOOLEAN DEFAULT 0,
            email_opened BOOLEAN DEFAULT 0,
            email_clicked BOOLEAN DEFAULT 0,
            email_opened_at TIMESTAMP,
            email_clicked_at TIMESTAMP,
            source TEXT DEFAULT 'google_dorks' CHECK(source IN ('google_dorks', 'linkedin', 'website_scraping', 'manual', 'import')),
            raw_data TEXT,
            last_contact_date TIMESTAMP,
            response_time INTEGER,
            notes TEXT
        )
        ''')
        
        # Table des campagnes email
        self.cursor.execute('''
        CREATE TABLE IF NOT EXISTS email_campaigns (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            prospect_id INTEGER NOT NULL,
            subject TEXT NOT NULL,
            content TEXT NOT NULL,
            sent_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            opened_at TIMESTAMP,
            clicked_at TIMESTAMP,
            tracking_id TEXT UNIQUE NOT NULL,
            delivery_status TEXT DEFAULT 'sent' CHECK(delivery_status IN ('sent', 'delivered', 'opened', 'clicked', 'bounced', 'failed')),
            bounce_reason TEXT,
            spam_report BOOLEAN DEFAULT 0,
            forwarded BOOLEAN DEFAULT 0,
            FOREIGN KEY (prospect_id) REFERENCES prospects (id) ON DELETE CASCADE
        )
        ''')
        
        # Table des logs système
        self.cursor.execute('''
        CREATE TABLE IF NOT EXISTS system_logs (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            level TEXT NOT NULL CHECK(level IN ('DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL')),
            message TEXT NOT NULL,
            module TEXT,
            function TEXT,
            line_number INTEGER,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            extra_data TEXT,
            user_id TEXT,
            session_id TEXT,
            request_id TEXT
        )
        ''')
        
        # Table des templates d'email
        self.cursor.execute('''
        CREATE TABLE IF NOT EXISTS email_templates (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            subject_template TEXT NOT NULL,
            content_template TEXT NOT NULL,
            language TEXT DEFAULT 'fr' CHECK(language IN ('fr', 'en')),
            category TEXT DEFAULT 'audit',
            is_active BOOLEAN DEFAULT 1,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            created_by TEXT
        )
        ''')
        
        # Table des tâches planifiées
        self.cursor.execute('''
        CREATE TABLE IF NOT EXISTS scheduled_tasks (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            task_name TEXT NOT NULL,
            task_type TEXT NOT NULL CHECK(task_type IN ('search', 'qualify', 'send', 'cleanup')),
            status TEXT DEFAULT 'pending' CHECK(status IN ('pending', 'running', 'completed', 'failed')),
            scheduled_at TIMESTAMP NOT NULL,
            started_at TIMESTAMP,
            completed_at TIMESTAMP,
            result TEXT,
            error_message TEXT,
            retry_count INTEGER DEFAULT 0,
            max_retries INTEGER DEFAULT 3,
            next_run_at TIMESTAMP,
            is_active BOOLEAN DEFAULT 1,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
        ''')
        
        # Table des performances
        self.cursor.execute('''
        CREATE TABLE IF NOT EXISTS performance_metrics (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            metric_name TEXT NOT NULL,
            metric_value REAL NOT NULL,
            metric_date DATE NOT NULL,
            dimension TEXT,
            dimension_value TEXT,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
        ''')
        
        # Table des configurations
        self.cursor.execute('''
        CREATE TABLE IF NOT EXISTS app_config (
            key TEXT PRIMARY KEY,
            value TEXT NOT NULL,
            description TEXT,
            is_sensitive BOOLEAN DEFAULT 0,
            last_updated TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            updated_by TEXT
        )
        ''')
        
        # Table des exports
        self.cursor.execute('''
        CREATE TABLE IF NOT EXISTS exports (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            file_name TEXT NOT NULL,
            file_type TEXT NOT NULL CHECK(file_type IN ('csv', 'excel', 'json')),
            export_type TEXT NOT NULL CHECK(export_type IN ('prospects', 'campaigns', 'logs', 'stats')),
            record_count INTEGER DEFAULT 0,
            file_path TEXT NOT NULL,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            created_by TEXT
        )
        ''')
        
        logger.info("Tables créées avec succès")
    
    def _create_indexes(self):
        """Crée les indexes pour optimiser les performances"""
        
        # Index pour la table prospects
        self.cursor.execute("CREATE INDEX IF NOT EXISTS idx_prosects_status ON prospects(status)")
        self.cursor.execute("CREATE INDEX IF NOT EXISTS idx_prosects_email ON prospects(email)")
        self.cursor.execute("CREATE INDEX IF NOT EXISTS idx_prosects_company ON prospects(company)")
        self.cursor.execute("CREATE INDEX IF NOT EXISTS idx_prosects_qualification_score ON prospects(qualification_score)")
        self.cursor.execute("CREATE INDEX IF NOT EXISTS idx_prosects_date_added ON prospects(date_added)")
        self.cursor.execute("CREATE INDEX IF NOT EXISTS idx_prosects_country ON prospects(country)")
        self.cursor.execute("CREATE INDEX IF NOT EXISTS idx_prosects_sector ON prospects(sector)")
        
        # Index pour la table email_campaigns
        self.cursor.execute("CREATE INDEX IF NOT EXISTS idx_campaigns_prospect_id ON email_campaigns(prospect_id)")
        self.cursor.execute("CREATE INDEX IF NOT EXISTS idx_campaigns_tracking_id ON email_campaigns(tracking_id)")
        self.cursor.execute("CREATE INDEX IF NOT EXISTS idx_campaigns_sent_at ON email_campaigns(sent_at)")
        self.cursor.execute("CREATE INDEX IF NOT EXISTS idx_campaigns_delivery_status ON email_campaigns(delivery_status)")
        
        # Index pour la table system_logs
        self.cursor.execute("CREATE INDEX IF NOT EXISTS idx_logs_level ON system_logs(level)")
        self.cursor.execute("CREATE INDEX IF NOT EXISTS idx_logs_created_at ON system_logs(created_at)")
        self.cursor.execute("CREATE INDEX IF NOT EXISTS idx_logs_module ON system_logs(module)")
        
        # Index pour la table scheduled_tasks
        self.cursor.execute("CREATE INDEX IF NOT EXISTS idx_tasks_status ON scheduled_tasks(status)")
        self.cursor.execute("CREATE INDEX IF NOT EXISTS idx_tasks_scheduled_at ON scheduled_tasks(scheduled_at)")
        
        # Index pour la table performance_metrics
        self.cursor.execute("CREATE INDEX IF NOT EXISTS idx_metrics_name_date ON performance_metrics(metric_name, metric_date)")
        
        # Index pour la table email_templates
        self.cursor.execute("CREATE INDEX IF NOT EXISTS idx_templates_language ON email_templates(language)")
        self.cursor.execute("CREATE INDEX IF NOT EXISTS idx_templates_category ON email_templates(category)")
        
        logger.info("Indexes créés avec succès")
    
    def _create_triggers(self):
        """Crée les triggers pour la mise à jour automatique des timestamps"""
        
        # Trigger pour mettre à jour last_contact_date quand un prospect est contacté
        self.cursor.execute('''
        CREATE TRIGGER IF NOT EXISTS update_prospect_contact_date
        AFTER UPDATE ON prospects
        FOR EACH ROW
        WHEN NEW.date_contacted IS NOT NULL AND (OLD.date_contacted IS NULL OR NEW.date_contacted != OLD.date_contacted)
        BEGIN
            UPDATE prospects SET last_contact_date = CURRENT_TIMESTAMP WHERE id = NEW.id;
        END
        ''')
        
        # Trigger pour mettre à jour le timestamp des templates
        self.cursor.execute('''
        CREATE TRIGGER IF NOT EXISTS update_template_timestamp
        AFTER UPDATE ON email_templates
        FOR EACH ROW
        BEGIN
            UPDATE email_templates SET updated_at = CURRENT_TIMESTAMP WHERE id = NEW.id;
        END
        ''')
        
        # Trigger pour logger les changements de statut des prospects
        self.cursor.execute('''
        CREATE TRIGGER IF NOT EXISTS log_prospect_status_change
        AFTER UPDATE ON prospects
        FOR EACH ROW
        WHEN NEW.status != OLD.status
        BEGIN
            INSERT INTO system_logs (level, message, module, extra_data)
            VALUES (
                'INFO',
                'Statut du prospect changé de ' || OLD.status || ' à ' || NEW.status,
                'prospects',
                json_object('prospect_id', NEW.id, 'old_status', OLD.status, 'new_status', NEW.status)
            );
        END
        ''')
        
        logger.info("Triggers créés avec succès")
    
    def _create_views(self):
        """Crée les vues pour des requêtes courantes"""
        
        # Vue des statistiques des prospects
        self.cursor.execute('''
        CREATE VIEW IF NOT EXISTS vw_prospect_stats AS
        SELECT 
            status,
            COUNT(*) as count,
            AVG(qualification_score) as avg_score,
            MIN(qualification_score) as min_score,
            MAX(qualification_score) as max_score
        FROM prospects
        GROUP BY status
        ''')
        
        # Vue des statistiques des campagnes
        self.cursor.execute('''
        CREATE VIEW IF NOT EXISTS vw_campaign_stats AS
        SELECT 
            DATE(sent_at) as sent_date,
            COUNT(*) as sent_count,
            SUM(CASE WHEN opened_at IS NOT NULL THEN 1 ELSE 0 END) as opened_count,
            SUM(CASE WHEN clicked_at IS NOT NULL THEN 1 ELSE 0 END) as clicked_count,
            ROUND(SUM(CASE WHEN opened_at IS NOT NULL THEN 1.0 ELSE 0.0 END) / COUNT(*) * 100, 2) as open_rate,
            ROUND(SUM(CASE WHEN clicked_at IS NOT NULL THEN 1.0 ELSE 0.0 END) / 
                  CASE WHEN SUM(CASE WHEN opened_at IS NOT NULL THEN 1.0 ELSE 0.0 END) > 0 
                       THEN SUM(CASE WHEN opened_at IS NOT NULL THEN 1.0 ELSE 0.0 END) 
                       ELSE 1 END * 100, 2) as click_rate
        FROM email_campaigns
        GROUP BY DATE(sent_at)
        ''')
        
        # Vue de performance des prospects
        self.cursor.execute('''
        CREATE VIEW IF NOT EXISTS vw_prospect_performance AS
        SELECT 
            p.id,
            p.name,
            p.company,
            p.sector,
            p.country,
            p.status,
            p.qualification_score,
            ec.subject,
            ec.sent_at,
            ec.opened_at,
            ec.clicked_at,
            CASE WHEN ec.opened_at IS NOT NULL THEN 1 ELSE 0 END as email_opened,
            CASE WHEN ec.clicked_at IS NOT NULL THEN 1 ELSE 0 END as email_clicked,
            CASE WHEN ec.opened_at IS NOT NULL THEN 
                 JULIANDAY(ec.opened_at) - JULIANDAY(ec.sent_at) 
            ELSE NULL END as days_to_open
        FROM prospects p
        LEFT JOIN email_campaigns ec ON p.id = ec.prospect_id
        ''')
        
        # Vue des activités récentes
        self.cursor.execute('''
        CREATE VIEW IF NOT EXISTS vw_recent_activity AS
        SELECT 
            'prospect' as activity_type,
            p.id as item_id,
            p.name as title,
            p.date_added as timestamp,
            p.status as status
        FROM prospects p
        UNION ALL
        SELECT 
            'campaign' as activity_type,
            ec.id as item_id,
            ec.subject as title,
            ec.sent_at as timestamp,
            ec.delivery_status as status
        FROM email_campaigns ec
        ORDER BY timestamp DESC
        LIMIT 50
        ''')
        
        logger.info("Vues créées avec succès")
    
    def _insert_default_data(self):
        """Insère les données par défaut"""
        
        # Configurations par défaut
        default_configs = [
            ('app_name', 'EBUSINESS AI', 'Nom de l\'application', 0),
