            ('timezone', 'Europe/Paris', 'Fuseau horaire', 0),
            ('target_sectors', '["Mode", "Électronique", "Services", "Digital", "Retail"]', 'Secteurs cibles', 0),
            ('target_countries', '["France", "Belgique", "Suisse", "Luxembourg", "Monaco", "Canada (Québec)"]', 'Pays cibles', 0),
            ('min_company_size', '10000', 'Taille minimale d\'entreprise', 0),
            ('max_company_size', '100000', 'Taille maximale d\'entreprise', 0),
