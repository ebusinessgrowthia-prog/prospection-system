        ]
        
        for key, value, description, is_sensitive in default_configs:
            self.cursor.execute('''
            INSERT OR IGNORE INTO app_config (key, value, description, is_sensitive)
            VALUES (?, ?, ?, ?)
            ''', (key, value, description, is_sensitive))
        
        # Templates d'email par défaut
        default_templates = [
            ('Audit FR', 
             'Proposition d\'audit gratuit pour {company}', 
             'Cher {name},\n\nJ\'ai remarqué que votre entreprise {company} dans le secteur {sector} pourrait bénéficier d\'un audit gratuit de sa présence en ligne.\n\n{problem}\n\nJe vous propose une analyse complète de :\n- Votre stratégie de contenu\n- Votre référencement naturel\n- L\'expérience utilisateur\n- Les opportunités d\'amélioration\n\nCet audit est sans engagement et vous donnera des pistes concrètes pour augmenter votre chiffre d\'affaires.\n\nSouhaitez-vous que je vous prépare une proposition détaillée ?\n\nCordialement,\n{your_name}\n{your_title}\n{your_location}\n\n{landing_page}', 
